// ==== COST GUARD TEST FIXTURE: DO NOT DEPLOY ====
// This is a deliberate counterexample for testing the cloudflare-cost-guard
// skill. Cases in this folder contain code that can run up a Cloudflare bill
// on purpose. Never deploy it, run it, or copy it into a real project.
// ==== END OF TEST FIXTURE NOTICE ====

{
  "name": "tutor-sessions",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sessions.tutor.example", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "TutorSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TutorSession"] }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "tutor-snapshots" }],
  "kv_namespaces": [{ "binding": "AUTH", "id": "00000000000000000000000000000000" }]
}
