{
  "name": "link-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "links", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "kv_namespaces": [{ "binding": "LINKS", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "1003", "simple": { "limit": 100, "period": 60 } }
  ]
}
