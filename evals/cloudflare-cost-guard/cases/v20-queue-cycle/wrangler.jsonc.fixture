// ==== COST GUARD TEST FIXTURE: DO NOT DEPLOY ====
// This is a deliberate counterexample for testing the cloudflare-cost-guard
// skill. Cases in this folder contain code that can run up a Cloudflare bill
// on purpose. Never deploy it, run it, or copy it into a real project.
// ==== END OF TEST FIXTURE NOTICE ====

{
  "name": "doc-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "docs-in.paperflow.example", "custom_domain": true }],
  "queues": {
    "producers": [
      { "binding": "INGEST", "queue": "doc-ingest" },
      { "binding": "ENRICH", "queue": "doc-enrich" }
    ],
    "consumers": [
      { "queue": "doc-ingest", "max_batch_size": 10, "max_retries": 3, "dead_letter_queue": "doc-ingest-dlq" },
      { "queue": "doc-enrich", "max_batch_size": 10, "max_retries": 3, "dead_letter_queue": "doc-enrich-dlq" }
    ]
  },
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "paperflow-docs" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "paperflow", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "3101", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "ENRICH_API": "https://api.entity-extract.example/v1/entities" }
}
