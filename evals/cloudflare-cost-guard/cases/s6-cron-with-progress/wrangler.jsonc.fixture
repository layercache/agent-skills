// ==== COST GUARD TEST FIXTURE: DO NOT DEPLOY ====
// This is a deliberate counterexample for testing the cloudflare-cost-guard
// skill. Cases in this folder contain code that can run up a Cloudflare bill
// on purpose. Never deploy it, run it, or copy it into a real project.
// ==== END OF TEST FIXTURE NOTICE ====

{
  "name": "newsdesk",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "search.newsdesk.example", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "newsdesk", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "kv_namespaces": [{ "binding": "KEYS", "id": "00000000000000000000000000000000" }],
  "vectorize": [{ "binding": "VECTORS", "index_name": "articles" }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "FEED_URL": "https://feeds.partner.example/v2/latest?limit=100",
    "LEGACY_KEY_SCAN": "true"
  }
}
