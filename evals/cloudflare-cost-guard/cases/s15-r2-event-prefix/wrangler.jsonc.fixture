// ==== COST GUARD TEST FIXTURE: DO NOT DEPLOY ====
// This is a deliberate counterexample for testing the cloudflare-cost-guard
// skill. Cases in this folder contain code that can run up a Cloudflare bill
// on purpose. Never deploy it, run it, or copy it into a real project.
// ==== END OF TEST FIXTURE NOTICE ====

{
  "name": "media-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "media.clipshare.example", "custom_domain": true }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clipshare-media" }],
  "queues": {
    "consumers": [
      { "queue": "media-events", "max_batch_size": 20, "max_retries": 3, "dead_letter_queue": "media-events-dlq" }
    ]
  },
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "3201", "simple": { "limit": 10, "period": 60 } }
  ]
}
