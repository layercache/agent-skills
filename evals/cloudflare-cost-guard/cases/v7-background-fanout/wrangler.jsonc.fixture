{
  "name": "daily-digest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "digest", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "kv_namespaces": [{ "binding": "PREFS", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "DIGESTS", "bucket_name": "digests" }],
  "queues": { "producers": [{ "binding": "EMAILS", "queue": "digest-emails" }] }
}
