// ==== COST GUARD TEST FIXTURE: DO NOT DEPLOY ====
// This is a deliberate counterexample for testing the cloudflare-cost-guard
// skill. Cases in this folder contain code that can run up a Cloudflare bill
// on purpose. Never deploy it, run it, or copy it into a real project.
// ==== END OF TEST FIXTURE NOTICE ====

{
  "name": "inbox-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agents.mailpilot.example", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "InboxAgent", "class_name": "InboxAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxAgent"] }],
  "vars": { "MAIL_API": "https://api.mailhub.example/v1" }
}
