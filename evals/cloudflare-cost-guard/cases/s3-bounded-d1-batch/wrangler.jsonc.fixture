{
  "name": "event-import",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "events", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "ratelimits": [
    { "name": "IMPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
